{
  "name": "vmeste",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-pdf-worker.mjs",
    "prebuild": "node scripts/prepare-pdf-worker.mjs",
    "prebuild:pages": "node scripts/prepare-pdf-worker.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "worker:login": "node --env-file-if-exists=.env.local scripts/cloud-worker.mjs --login",
    "worker": "node --env-file-if-exists=.env.local scripts/cloud-worker.mjs",
    "worker:once": "node --env-file-if-exists=.env.local scripts/cloud-worker.mjs --once",
    "worker:status": "node --env-file-if-exists=.env.local scripts/cloud-worker.mjs --status",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@napi-rs/canvas": "^1.0.13",
    "@supabase/supabase-js": "2.118.0",
    "idb": "^8.0.3",
    "image-size": "^2.0.4",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  }
}
