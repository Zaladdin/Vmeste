# Default: use the existing ChatGPT sign-in of local Codex CLI.
VMESTE_RECOGNITION_PROVIDER=codex
# Initial daily model-call limit (0 pauses recognition, maximum 100).
# Saved changes in the app take precedence; reset is at 00:00 UTC.
VMESTE_DAILY_RECOGNITION_LIMIT=10
# Optional absolute executable path if 'codex' is not available on PATH.
# CODEX_EXECUTABLE=C:/path/to/codex.exe
# API is an explicit alternative only: VMESTE_RECOGNITION_PROVIDER=openai.
# Put a real API key only in your environment or ignored .env.local.
OPENAI_API_KEY=
# Optional: PDF/image-capable model supporting Structured Outputs.
OPENAI_RECOGNITION_MODEL=gpt-5-mini
